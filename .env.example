# Absolute origin of the deployed site.
# Drives canonical tags, OpenGraph URLs, sitemap.xml, robots.txt Host and llm.txt.
# No trailing slash, no path. www is allowed but must be the host you actually serve.
NEXT_PUBLIC_SITE_URL=https://dhirajarya.in

# Groq API key for portfolio AI chatbot (model: openai/gpt-oss-20b)
GROQ_AI_API_KEY=your_groq_api_key_here
GROQ_AI_MODEL="openai/gpt-oss-20b"

